<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    <connectionStrings>
        <add name="iamDb" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=iam_db;Persist Security Info=True;User ID={sqlUser};Password={sqlPassword};Trust Server Certificate=True" />
		<add name="coreDb" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=core_db;Persist Security Info=True;User ID={sqlUser};Password={sqlPassword};Trust Server Certificate=True"/>
    </connectionStrings>
    <appSettings>
        <add key="logFileDirectory" value="\SystemLogs"/>
        <add key="sqlUser" value="stock_helper_user"/>
        <add key="sqlPassword" value="s7bOGv66G'*c"/>
        <!-- Relativa al directorio del ejecutable. UI.csproj copia I18n\ a la salida,
             asi funciona igual en desarrollo y en la app instalada. -->
        <add key="LanguageFolderPath" value="I18n"/>
        <add key="LanguageFileName" value="translations"/>
        <add key="Culture" value="en-En"/>
        <!-- Daily backup (REQ.006). The SQL Server service account must have write access to this folder. -->
        <add key="backupDirectory" value="C:\StockHelperBackups"/>
        <add key="backupRetentionDays" value="14"/>
    </appSettings>
</configuration>