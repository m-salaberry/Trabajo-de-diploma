StockHelper/docs/Manual_del_Programador_API_StockHelper.pdf

# ---------------------------------------------------------------------------
# Secretos: NO subir. El repositorio es publico.
# Estos archivos existen solo para fijar la clave de cifrado de la aplicacion
# y quedan unicamente en la maquina de desarrollo.
# ---------------------------------------------------------------------------
set-secret-key.ps1
setup.ps1
STOCK_HELPER_SECRET_KEY.backup.txt

# ---------------------------------------------------------------------------
# Material de trabajo (capturas de pantalla de los manuales).
